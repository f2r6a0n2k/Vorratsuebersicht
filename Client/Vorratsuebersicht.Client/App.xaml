<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vorratsuebersicht.Client.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#3498db</Color>
            <Color x:Key="Secondary">#2c3e50</Color>
            <Color x:Key="Danger">#e74c3c</Color>
            <Color x:Key="Success">#27ae60</Color>
            <Color x:Key="Warning">#f39c12</Color>
            <Color x:Key="Light">#f0f2f5</Color>
            <Color x:Key="Dark">#333333</Color>
            <Color x:Key="Gray">#666666</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
