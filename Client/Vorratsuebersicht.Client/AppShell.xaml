<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Vorratsuebersicht.Client.Pages"
       x:Class="Vorratsuebersicht.Client.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Start" ContentTemplate="{DataTemplate pages:MainPage}" Icon="{OnPlatform Default=''}" />
        <ShellContent Title="Artikel" ContentTemplate="{DataTemplate pages:ArticlesPage}" />
        <ShellContent Title="Lager" ContentTemplate="{DataTemplate pages:StoragePage}" />
        <ShellContent Title="Einkauf" ContentTemplate="{DataTemplate pages:ShoppingPage}" />
        <ShellContent Title="Sync" ContentTemplate="{DataTemplate pages:SyncPage}" />
    </TabBar>

</Shell>
