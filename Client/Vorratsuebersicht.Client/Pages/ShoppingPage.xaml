<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vorratsuebersicht.Client.Pages.ShoppingPage"
             Title="Einkaufszettel">

    <CollectionView x:Name="ShoppingList" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="8,4" Padding="12" CornerRadius="8" HasShadow="True" BackgroundColor="White">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnItemTapped" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{Binding ArticleName}" FontSize="16" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding Quantity, StringFormat='Menge: {0}'}" FontSize="13" TextColor="{StaticResource Gray}" />
                                <Label FontSize="13">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Bought}" Value="True">
                                            <Setter Property="Text" Value="✔ Gekauft" />
                                            <Setter Property="TextColor" Value="Green" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Bought}" Value="False">
                                            <Setter Property="Text" Value="☐ Offen" />
                                            <Setter Property="TextColor" Value="{StaticResource Gray}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding Bought}" VerticalOptions="Center"
                                Toggled="OnBoughtToggled" />
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.EmptyView>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label Text="Einkaufszettel ist leer" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray}" />
                <Label Text="Tippe auf einen Artikel, um die Menge zu ändern" HorizontalTextAlignment="Center" FontSize="12" TextColor="{StaticResource Gray}" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
