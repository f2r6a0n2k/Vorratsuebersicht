{"repo": {"timestamp": 1779099716000, "version": 20002, "name": "Vorrats\u00fcbersicht Sync", "icon": "icon.png", "address": "https://f2r6a0n2k.github.io/Vorratsuebersicht/repo", "description": "Verteilte Datenbank-Synchronisation f\u00fcr Vorrats\u00fcbersicht. LAN-Sync, Web UI, Off-Grid."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "f2r6a0n2k", "categories": ["Utilities"], "suggestedVersionName": "1.0.0", "suggestedVersionCode": "1", "description": "VorratSync is the companion app for Vorrats\u00fcbersicht's distributed\ndatabase synchronization feature.\n\nConnect to a Vorrats\u00fcbersicht Master (sync server) on your local\nnetwork to view and edit your pantry inventory, storage items,\nand shopping list from any Android device.\n\nFeatures:\n* Automatic master discovery via UDP broadcast\n* Real-time sync with master server\n* Offline-first: changes stored locally, synced when connected\n* PIN-based access control\n* Clean modern UI built with .NET MAUI", "issueTracker": "https://github.com/f2r6a0n2k/Vorratsuebersicht/issues", "license": "Apache-2.0", "sourceCode": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "summary": "LAN sync client for Vorrats\u00fcbersicht", "webSite": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "added": 1779099715000, "packageName": "de.stryi.Vorratsuebersicht.SyncClient", "lastUpdated": 1779099715000, "localized": {"en-US": {"name": "VorratSync"}}}, {"authorName": "Christian Stryi, f2r6a0n2k", "categories": ["Utilities, Food & Drink"], "changelog": "https://github.com/Stryi/Vorratsuebersicht/blob/master/ReadMe%20-%20Release%20Notes.txt", "suggestedVersionName": "9.00-sync.2", "suggestedVersionCode": "150", "description": "Keep track of your pantry items and their expiration dates.\nNever throw away food because you forgot what's in your cupboard!\n\nFeatures:\n* Article management with categories, barcodes, and images\n* Inventory tracking with quantities and best-before dates\n* Expiry warnings and alerts\n* Shopping list management\n* Barcode scanning\n* LAN sync: share data between multiple devices without internet\n* Web interface: access your data from any browser\n* Works off-grid: no internet connection required\n\nThis is a fork that adds distributed database synchronization\n(LAN sync via REST API).", "issueTracker": "https://github.com/f2r6a0n2k/Vorratsuebersicht/issues", "license": "Apache-2.0", "sourceCode": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "summary": "Monitor best-before dates of your food supplies", "webSite": "https://github.com/Stryi/Vorratsuebersicht", "added": 1779099716000, "icon": "de.stryi.vorratsuebersicht.sync.150.png", "packageName": "de.stryi.vorratsuebersicht.sync", "lastUpdated": 1779099716000, "localized": {"en-US": {"name": "Vorrats\u00fcbersicht"}}}], "packages": {"de.stryi.Vorratsuebersicht.SyncClient": [{"added": 1779099715000, "apkName": "VorratSync-1.0.83-android.apk", "hash": "7ae64148a6bf96965dc29b9f6e16da42a6961f24226aa95a1c243a01fcfc5887", "hashType": "sha256", "minSdkVersion": 21, "nativecode": ["arm64-v8a", "armeabi-v7a"], "packageName": "de.stryi.Vorratsuebersicht.SyncClient", "sig": "da8d02289bd6ef7910218b676c33ea5d", "signer": "d9b32562cde62b1f9a334e64d67e5bf5b92e031bd6cffd69f65c0f37f73bd72c", "size": 33144598, "targetSdkVersion": 34, "uses-permission": [["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.INTERNET", null], ["android.permission.ACCESS_WIFI_STATE", null], ["android.permission.CHANGE_WIFI_STATE", null], ["android.permission.ACCESS_FINE_LOCATION", null], ["de.stryi.Vorratsuebersicht.SyncClient.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION", null]], "versionCode": 83, "versionName": "1.0.83"}], "de.stryi.vorratsuebersicht.sync": [{"added": 1779099716000, "apkName": "de.stryi.vorratsuebersicht.sync_150.apk", "hash": "a1a2adf03847f7df98aae4f7e585c534c9bf041ca3d5b8e59763451a78278335", "hashType": "sha256", "minSdkVersion": 19, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86",