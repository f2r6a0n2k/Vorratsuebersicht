{"repo": {"timestamp": 1779000485000, "version": 20002, "name": "Vorrats\u00fcbersicht Sync", "icon": "icon.png", "address": "https://f2r6a0n2k.github.io/Vorratsuebersicht/repo", "description": "Verteilte Datenbank-Synchronisation f\u00fcr Vorrats\u00fcbersicht. LAN-Sync, Web UI, Off-Grid."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "f2r6a0n2k", "categories": ["Utilities"], "suggestedVersionName": "1.0.0", "suggestedVersionCode": "1", "description": "VorratSync is the companion app for Vorrats\u00fcbersicht's distributed\ndatabase synchronization feature.\n\nConnect to a Vorrats\u00fcbersicht Master (sync server) on your local\nnetwork to view and edit your pantry inventory, storage items,\nand shopping list from any Android device.\n\nFeatures:\n* Automatic master discovery via UDP broadcast\n* Real-time sync with master server\n* Offline-first: changes stored locally, synced when connected\n* PIN-based access control\n* Clean modern UI built with .NET MAUI", "issueTracker": "https://github.com/f2r6a0n2k/Vorratsuebersicht/issues", "license": "Apache-2.0", "sourceCode": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "summary": "LAN sync client for Vorrats\u00fcbersicht", "webSite": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "added": 1779000484000, "packageName": "de.stryi.Vorratsuebersicht.SyncClient", "lastUpdated": 1779000484000, "localized": {"en-US": {"name": "VorratSync"}}}, {"authorName": "Christian Stryi, f2r6a0n2k", "categories": ["Utilities, Food & Drink"], "changelog": "https://github.com/Stryi/Vorratsuebersicht/blob/master/ReadMe%20-%20Release%20Notes.txt", "suggestedVersionName": "9.00-sync.2", "suggestedVersionCode": "150", "description": "Keep track of your pantry items and their expiration dates.\nNever throw away food because you forgot what's in your cupboard!\n\nFeatures:\n* Article management with categories, barcodes, and images\n* Inventory tracking with quantities and best-before dates\n* Expiry warnings and alerts\n* Shopping list management\n* Barcode scanning\n* LAN sync: share data between multiple devices without internet\n* Web interface: access your data from any browser\n* Works off-grid: no internet connection required\n\nThis is a fork that adds distributed database synchronization\n(LAN sync via REST API).", "issueTracker": "https://github.com/f2r6a0n2k/Vorratsuebersicht/issues", "license": "Apache-2.0", "sourceCode": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "summary": "Monitor best-before dates of your food supplies", "webSite": "https://github.com/Stryi/Vorratsuebersicht", "added": 1779000485000, "icon": "de.stryi.vorratsuebersicht.sync.150.png", "packageName": "de.stryi.vorratsuebersicht.sync", "lastUpdated": 1779000485000, "localized": {"en-US": {"name": "Vorrats\u00fcbersicht"}}}], "packages": {"de.stryi.Vorratsuebersicht.SyncClient": [{"added": 1779000484000, "apkName": "VorratSync-1.0.69-android.apk", "hash": "1a606906507fa7bedb6884bdbffe03a59806538522ea491ff39793d97dcda032", "hashType": "sha256", "minSdkVersion": 21, "nativecode": ["arm64-v8a", "x86_64"], "packageName": "de.stryi.Vorratsuebersicht.SyncClient", "sig": "a0c511f01a77a1bee9384ac712e30b9d", "signer": "4fda39b7c4b785009c0dc3fbc6bab47eda8bd2de56d4de3d19c3faec95761106", "size": 33401598, "targetSdkVersion": 34, "uses-permission": [["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.INTERNET", null], ["android.permission.ACCESS_WIFI_STATE", null], ["android.permission.CHANGE_WIFI_STATE", null], ["android.permission.ACCESS_FINE_LOCATION", null], ["de.stryi.Vorratsuebersicht.SyncClient.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION", null]], "versionCode": 69, "versionName": "1.0.69"}], "de.stryi.vorratsuebersicht.sync": [{"added": 1779000485000, "apkName": "de.stryi.vorratsuebersicht.sync_150.apk", "hash": "c0ae1bf538793b4a08e15cf8de1a8837f152ef1288e99f4771a4abb819a73bec", "hashType": "sha256", "minSdkVersion": 19, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86