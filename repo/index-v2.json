{"repo": {"name": {"en-US": "Vorratsübersicht Sync"}, "description": {"en-US": "Verteilte Datenbank-Synchronisation für Vorratsübersicht. LAN-Sync, Web UI, Off-Grid."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "6e5c6714b3cabd223edad8dd6920cb47672e700bb2ae9883c8c2b47c27c66767", "size": 828}}, "address": "https://f2r6a0n2k.github.io/Vorratsuebersicht/repo", "timestamp": 1779000485000, "categories": {"Utilities": {"name": {"en-US": "Utilities"}}, "Utilities, Food & Drink": {"name": {"en-US": "Utilities, Food & Drink"}}}}, "packages": {"de.stryi.Vorratsuebersicht.SyncClient": {"metadata": {"added": 1779000484000, "categories": ["Utilities"], "issueTracker": "https://github.com/f2r6a0n2k/Vorratsuebersicht/issues", "lastUpdated": 1779000484000, "license": "Apache-2.0", "sourceCode": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "webSite": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "authorName": "f2r6a0n2k", "name": {"en-US": "VorratSync"}, "summary": {"en-US": "LAN sync client for Vorratsübersicht"}, "description": {"en-US": "VorratSync is the companion app for Vorratsübersicht's distributed\ndatabase synchronization feature.\n\nConnect to a Vorratsübersicht Master (sync server) on your local\nnetwork to view and edit your pantry inventory, storage items,\nand shopping list from any Android device.\n\nFeatures:\n* Automatic master discovery via UDP broadcast\n* Real-time sync with master server\n* Offline-first: changes stored locally, synced when connected\n* PIN-based access control\n* Clean modern UI built with .NET MAUI"}, "preferredSigner": "4fda39b7c4b785009c0dc3fbc6bab47eda8bd2de56d4de3d19c3faec95761106"}, "versions": {"1a606906507fa7bedb6884bdbffe03a59806538522ea491ff39793d97dcda032": {"added": 1779000484000, "file": {"name": "/VorratSync-1.0.69-android.apk", "sha256": "1a606906507fa7bedb6884bdbffe03a59806538522ea491ff39793d97dcda032", "size": 33401598}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "1.0.69", "versionCode": 69, "usesSdk": {"minSdkVersion": 21, "targetSdkVersion": 34}, "signer": {"sha256": ["4fda39b7c4b785009c0dc3fbc6bab47eda8bd2de56d4de3d19c3faec95761106"]}, "usesPermission": [{"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.CHANGE_WIFI_STATE"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "de.stryi.Vorratsuebersicht.SyncClient.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}, "releaseChannels": ["Beta"]}}}, "de.stryi.vorratsuebersicht.sync": {"metadata": {"added": 1779000485000, "categories": ["Utilities, Food & Drink"], "changelog": "https://github.com/Stryi/Vorratsuebersicht/blob/master/ReadMe%20-%20Release%20Notes.txt", "issueTracker": "https://github.com/f2r6a0n2k/Vorratsuebersicht/issues", "lastUpdated": 1779000485000, "license": "Apache-2.0", "sourceCode": "https://github.com/f2r6a0n2k/Vorratsuebersicht", "webSite": "https://github.com/Stryi/Vorratsuebersicht", "authorName": "Christian Stryi, f2r6a0n2k", "name": {"en-US": "Vorratsübersicht"}, "summary": {"en-US": "Monitor best-before dates of your food supplies"}, "description": {"en-US": "Keep track of your pantry items and their expiration dates.\nNever throw away food because you forgot what's in your cupboard!\n\nFeatures:\n* Article management with categories, barcodes, and images\n* Inventory tracking with quantities and best-before dates\n* Expiry warnings and alerts\n* Shopping list management\n* Barcode scanning\n* LAN sync: share data between multiple devices without internet\n* Web interface: access your data from any browser\n* Works off-grid: no internet connection required\n\nThis is a fork that adds distributed database synchronization\n(LAN sync via REST API)."}, "icon": {"en-US": {"name": "/icons/de.stryi.vorratsuebersicht.sync.150.png", "sha256": "c171603fd04cd11d1f87dea1c9fcb6ac12606ffb2ab8c11506e30c9c35dd271f", "size": 2810}}, "preferredSigner": "7db9